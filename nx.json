{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "sharedGlobals": [
      {
        "runtime": "node --version"
      }
    ],
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/test/**",
      "!{projectRoot}/**/*.test.{js,mjs,ts,tsx}",
      "!{projectRoot}/coverage/**"
    ],
    "lintable": [
      "{projectRoot}/**/*.{js,mjs,cjs,ts,tsx,jsx,json,jsonc}",
      "{workspaceRoot}/biome.json",
      {
        "externalDependencies": [
          "@biomejs/biome"
        ]
      }
    ]
  },
  "targetDefaults": {
    "lint": {
      "cache": true,
      "inputs": [
        "lintable"
      ]
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "typecheck": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json"
      ]
    },
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ]
    }
  },
  "release": {
    "projects": [
      "graft",
      "canker",
      "deadwood",
      "cambium",
      "mycelium",
      "canopy",
      "oakgreen"
    ],
    "projectsRelationship": "independent",
    "version": {
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "specifierSource": "conventional-commits"
    },
    "changelog": {
      "automaticFromRef": true,
      "projectChangelogs": {
        "createRelease": "github",
        "file": false
      }
    },
    "git": {
      "commit": true,
      "commitMessage": "chore(release): publish [skip ci]",
      "tag": true,
      "push": true
    },
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    }
  },
  "analytics": false
}