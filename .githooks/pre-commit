#!/bin/sh
# git hands a hook variables that point at THIS repo's index and git dir.
# The checks run tests that drive git in repos of their own; inherited, those
# variables aim the tests' git at the wrong index. Checks read the working tree.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
exec pnpm verify
